@import url("Theme/DesignTokens.uss");
@import url("Theme/OrnateButton.uss");
@import url("Theme/Panels.uss");
@import url("Components/FloatingWindow/FloatingWindow.uss");

:root {
    cursor: var(--cursor-ui);
}

Button,
TextField,
Toggle,
Slider,
DropdownField,
IntegerField,
FloatField,
.si-button,
.unity-button,
.unity-base-field__input,
.unity-text-element__selectable,
.unity-base-slider__drag-container,
.unity-base-slider__fill,
.unity-base-slider__dragger,
.unity-base-slider__tracker,
.unity-base-popup-field__arrow,
.unity-base-popup-field__text {
    cursor: var(--cursor-hover);
}

Label,
.si-body,
.si-title,
.si-panel,
.si-panel__title,
.si-panel__label,
.si-hud-panel,
.loadout,
.loadout-overlay,
.loadout-panel,
.vendor,
.vendor-host,
.vendor-panel,
.floating-window,
.floating-window__content,
.floating-window__title {
    cursor: var(--cursor-ui);
}

.loadout-row,
.loadout-row__icon,
.loadout-slot,
.loadout-slot__icon,
.loadout-filter,
.loadout-open-button,
.vendor-row,
.vendor-tab,
.vendor-page__btn,
.floating-window__close,
.floating-window--draggable > .floating-window__header,
.si-button--icon {
    cursor: var(--cursor-hover);
}

.vendor-row--buyable {
    cursor: var(--cursor-trade);
}

.main-menu-stack {
    align-items: stretch;
    width: 320px;
}

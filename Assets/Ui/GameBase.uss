@import url("Theme/DesignTokens.uss");
@import url("Theme/OrnateButton.uss");
@import url("Theme/Panels.uss");

:root {
    cursor: var(--cursor-ui);
}

Button,
TextField,
Toggle,
Slider,
DropdownField,
IntegerField,
FloatField,
.si-button,
.unity-button,
.unity-base-field__input,
.unity-text-element__selectable,
.unity-base-slider__drag-container,
.unity-base-slider__fill,
.unity-base-slider__dragger,
.unity-base-slider__tracker,
.unity-base-popup-field__arrow,
.unity-base-popup-field__text {
    cursor: var(--cursor-hover);
}

Label,
.si-body,
.si-title,
.si-panel,
.si-panel__title,
.si-panel__label,
.si-hud-panel,
.loadout,
.loadout-overlay,
.loadout-panel,
.vendor,
.vendor-host,
.vendor-panel {
    cursor: var(--cursor-ui);
}

.loadout-row,
.loadout-row__icon,
.loadout-slot,
.loadout-slot__icon,
.loadout-filter,
.loadout-open-button,
.loadout-close-button,
.vendor-row,
.vendor-tab,
.vendor-title,
.vendor-close-button,
.vendor-page__btn {
    cursor: var(--cursor-hover);
}

.main-menu-stack {
    align-items: stretch;
    width: 320px;
}

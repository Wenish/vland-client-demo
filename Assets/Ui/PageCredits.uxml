<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/MainMenu.uss?fileID=7433441132597879392&amp;guid=645b526f6f65da14b84ed1a387c0c38e&amp;type=3#MainMenu"/>
    <engine:VisualElement name="PageCredits" class="page-content" style="align-items: center; justify-content: space-between; flex-grow: 1;">
        <engine:Label text="CREDITS" class="page-title"/>
        <engine:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
            <engine:Label text="SHADOW INFECTION" class="si-title" style="font-size: 36px; letter-spacing: 2px; color: rgb(254, 221, 183); margin-bottom: 12px;"/>
            <engine:Label text="A Game By" class="si-body" style="font-size: 18px; color: rgb(204, 208, 214); margin-bottom: 8px;"/>
            <engine:Label text="Jonas Voland" class="si-title" style="font-size: 32px; color: rgb(255, 244, 231);"/>
        </engine:VisualElement>
        <engine:VisualElement class="main-menu-stack">
            <OrnateButton text="BACK" name="ButtonBackToMenu" class="si-button si-button--compact" icon-image="project://database/Assets/Art/Ui/Icons/icon-back.svg?fileID=2800000&amp;guid=e1a1b2c3d4e5f60718293a4b5c6d7ea8&amp;type=3#icon-back"/>
        </engine:VisualElement>

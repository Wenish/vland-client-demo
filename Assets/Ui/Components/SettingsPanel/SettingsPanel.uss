.page-settings {
    min-height: 0;
    overflow: hidden;
    align-items: center;
}

.settings-panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    align-items: center;
    width: 100%;
    max-width: 724px;
    align-self: center;
}

.settings-panel__title {
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    font-size: 28px;
    color: rgb(254, 221, 183);
    -unity-text-align: upper-center;
    margin-bottom: 12px;
    letter-spacing: 1px;
}

.page-settings .settings-panel__title {
    font-size: 64px;
    letter-spacing: 4px;
    color: rgb(255, 244, 231);
    margin-bottom: 28px;
}

.settings-panel__actions {
    flex-shrink: 0;
    margin-top: 12px;
    align-items: stretch;
    width: 220px;
}

.settings-panel__actions .si-button {
    min-height: 36px;
    min-width: 0;
    width: 100%;
    font-size: 14px;
    letter-spacing: 1px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 3px;
    margin-bottom: 3px;
}

.settings-panel__actions .si-button__icon,
.settings-panel__actions .si-button .unity-button__image {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    align-self: stretch;
    margin-bottom: 10px;
    width: 100%;
}

.settings-tab {
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    height: 34px;
    min-height: 34px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 14px;
    padding-right: 14px;
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel/Cinzel-Bold.ttf?fileID=12800000&guid=a2b3c4d5e6f7081920a1b2c3d4e5f602&type=3#Cinzel-Bold");
    font-size: 12px;
    letter-spacing: 0.5px;
    color: rgb(204, 208, 214);
    background-color: rgba(0, 4, 10, 0.45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(152, 119, 81);
    border-right-color: rgb(152, 119, 81);
    border-top-color: rgb(152, 119, 81);
    border-bottom-color: rgb(152, 119, 81);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    cursor: var(--cursor-hover);
}

.settings-tab:hover {
    color: rgb(255, 244, 231);
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
    background-color: rgba(255, 244, 231, 0.08);
}

.settings-tab--active {
    color: rgb(254, 221, 183);
    background-color: rgba(253, 199, 135, 0.12);
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
}

.settings-scroll {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    max-width: 724px;
    align-self: center;
}

.settings-scroll > .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.settings-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    align-items: stretch;
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.settings-content {
    width: 100%;
    max-width: 700px;
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    color: rgb(255, 244, 231);
    align-items: stretch;
    flex-direction: column;
    padding-top: 12px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}

.settings-tab-content {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
}

/* Field styles — same approach as the old PageSettings.uss so they apply via template/host stylesheets */
.settings-panel .unity-base-field,
.settings-content .unity-base-field {
    font-size: 18px;
    color: rgb(255, 244, 231);
    background-color: transparent;
    border-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.settings-panel .unity-toggle .unity-toggle__checkmark,
.settings-content .unity-toggle .unity-toggle__checkmark {
    background-color: transparent;
    border-color: rgb(202, 159, 108);
    width: 22px;
    height: 22px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    -unity-background-image-tint-color: rgb(253, 199, 135);
}

.settings-panel Toggle:hover .unity-toggle__checkmark,
.settings-content Toggle:hover .unity-toggle__checkmark {
    border-color: rgb(253, 199, 135);
}

.settings-panel Toggle:focus .unity-toggle__checkmark,
.settings-content Toggle:focus .unity-toggle__checkmark {
    border-color: rgb(255, 244, 231);
}

.settings-panel .input-slider .unity-base-slider__tracker,
.settings-content .input-slider .unity-base-slider__tracker {
    background-color: rgb(1, 11, 31);
    border-width: 0;
}

.settings-panel .input-slider .unity-base-slider__fill,
.settings-content .input-slider .unity-base-slider__fill {
    background-color: rgb(202, 159, 108);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.settings-panel .input-slider .unity-base-slider__dragger,
.settings-content .input-slider .unity-base-slider__dragger {
    background-color: rgb(253, 199, 135);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.settings-panel .input-slider:hover .unity-base-slider__fill,
.settings-panel .input-slider:focus .unity-base-slider__fill,
.settings-content .input-slider:hover .unity-base-slider__fill,
.settings-content .input-slider:focus .unity-base-slider__fill {
    background-color: rgb(253, 199, 135);
}

.settings-panel .input-slider:hover .unity-base-slider__dragger,
.settings-panel .input-slider:focus .unity-base-slider__dragger,
.settings-content .input-slider:hover .unity-base-slider__dragger,
.settings-content .input-slider:focus .unity-base-slider__dragger {
    background-color: rgb(255, 244, 231);
}

.settings-panel .unity-base-popup-field__input,
.settings-panel .unity-base-text-field__input,
.settings-content .unity-base-popup-field__input,
.settings-content .unity-base-text-field__input {
    font-size: 16px;
    color: rgb(255, 244, 231);
    background-color: rgba(0, 4, 10, 0.7);
    border-width: 2px;
    border-color: rgb(202, 159, 108);
    margin-left: 0;
    padding-top: 2px;
    padding-right: 12px;
    padding-left: 12px;
    padding-bottom: 2px;
}

.settings-panel .unity-base-popup-field:hover .unity-base-popup-field__input,
.settings-panel .unity-base-text-field__input:hover,
.settings-content .unity-base-popup-field:hover .unity-base-popup-field__input,
.settings-content .unity-base-text-field__input:hover {
    border-color: rgb(253, 199, 135);
}

.settings-panel .unity-base-popup-field:focus .unity-base-popup-field__input,
.settings-panel .unity-base-text-field:focus .unity-base-text-field__input,
.settings-content .unity-base-popup-field:focus .unity-base-popup-field__input,
.settings-content .unity-base-text-field:focus .unity-base-text-field__input {
    border-color: rgb(255, 244, 231);
}

.settings-panel .unity-base-text-field__input--placeholder,
.settings-content .unity-base-text-field__input--placeholder {
    color: rgb(154, 161, 174);
}

.settings-panel .unity-base-popup-field__arrow,
.settings-content .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(253, 199, 135);
}

.settings-panel .unity-base-field__input,
.settings-panel .unity-base-field__label,
.settings-panel .unity-text-element__selectable,
.settings-panel .unity-base-slider__drag-container,
.settings-panel .unity-base-slider__fill,
.settings-panel .unity-base-slider__dragger,
.settings-panel .unity-base-popup-field__arrow,
.settings-panel .unity-base-popup-field__text,
.settings-content .unity-base-field__input,
.settings-content .unity-base-field__label,
.settings-content .unity-text-element__selectable,
.settings-content .unity-base-slider__drag-container,
.settings-content .unity-base-slider__fill,
.settings-content .unity-base-slider__dragger,
.settings-content .unity-base-popup-field__arrow,
.settings-content .unity-base-popup-field__text {
    cursor: var(--cursor-hover);
}

.settings-panel .unity-base-field__label,
.settings-content .unity-base-field__label {
    color: rgb(255, 244, 231);
}

.settings-panel .unity-base-field:hover > .unity-base-field__label,
.settings-content .unity-base-field:hover > .unity-base-field__label {
    color: rgb(254, 221, 183);
}

.settings-panel .unity-base-field:focus > .unity-base-field__label,
.settings-panel .unity-base-field:focus-within > .unity-base-field__label,
.settings-content .unity-base-field:focus > .unity-base-field__label,
.settings-content .unity-base-field:focus-within > .unity-base-field__label {
    color: rgb(254, 221, 183);
}

.settings-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.settings-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.settings-scroll .unity-scroller--vertical {
    width: 12px;
    margin-left: 8px;
    background-color: transparent;
    border-width: 0;
}

.settings-scroll .unity-base-slider--vertical {
    width: 12px;
    min-width: 12px;
}

.settings-scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
}

.settings-scroll .unity-scroller--vertical,
.settings-scroll .unity-base-slider--vertical,
.settings-scroll .unity-base-slider__tracker {
    cursor: var(--cursor-ui);
}

.settings-scroll .unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgb(1, 11, 31);
    width: 8px;
    min-width: 8px;
    left: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(101, 80, 54);
}

.settings-scroll .unity-base-slider__dragger {
    background-color: rgb(202, 159, 108);
    width: 8px;
    min-width: 8px;
    left: 2px;
    border-width: 0;
    cursor: var(--cursor-hover);
}

.settings-scroll .unity-scroller--vertical:hover .unity-base-slider__dragger,
.settings-scroll .unity-base-slider__dragger:hover {
    background-color: rgb(253, 199, 135);
}

/* Overlay host: panel content sits inside the window chrome, so strip duplicate title/back chrome */
.settings-panel--embedded .settings-panel__title {
    display: none;
}

.settings-panel--embedded .settings-panel__actions {
    width: 100%;
    max-width: 220px;
    align-self: center;
}

.settings-panel--embedded #ButtonBackToMenu {
    display: none;
}

.settings-panel--embedded {
    max-width: 100%;
    width: 100%;
}

.settings-panel--embedded .settings-scroll {
    max-width: 100%;
}

.settings-panel--embedded .settings-content {
    max-width: 100%;
    background-color: transparent;
    border-width: 0;
    padding-top: 4px;
    padding-right: 0;
    padding-bottom: 4px;
    padding-left: 0;
}

.keybind-hint {
    font-size: 13px;
    color: rgb(204, 208, 214);
    margin-bottom: 10px;
    white-space: normal;
}

.keybind-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(101, 80, 54);
}

.keybind-header__action {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: rgb(154, 161, 174);
    letter-spacing: 0.5px;
}

.keybind-header__slot {
    width: 92px;
    min-width: 92px;
    max-width: 92px;
    margin-left: 6px;
    flex-grow: 0;
    flex-shrink: 0;
    font-size: 12px;
    color: rgb(154, 161, 174);
    -unity-text-align: middle-center;
}

.keybind-list {
    width: 100%;
    flex-direction: column;
}

.keybind-section {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(202, 159, 108);
}

.keybind-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 36px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.keybind-row:hover {
    background-color: rgba(253, 199, 135, 0.08);
}

.keybind-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 16px;
    color: rgb(255, 244, 231);
}

.keybind-slot {
    width: 92px;
    min-width: 92px;
    max-width: 92px;
    height: 28px;
    margin-left: 6px;
    padding-left: 6px;
    padding-right: 6px;
    flex-grow: 0;
    flex-shrink: 0;
    font-size: 13px;
    color: rgb(255, 244, 231);
    background-color: rgba(0, 4, 10, 0.7);
    border-width: 2px;
    border-color: rgb(202, 159, 108);
    -unity-text-align: middle-center;
    cursor: var(--cursor-hover);
}

.keybind-slot:hover {
    border-color: rgb(253, 199, 135);
}

.keybind-slot--empty {
    color: rgb(154, 161, 174);
}

.keybind-slot--listening {
    color: rgb(254, 221, 183);
    border-color: rgb(253, 199, 135);
    background-color: rgba(253, 199, 135, 0.12);
}

.keybind-slot--reject {
    border-color: rgb(220, 90, 70);
}

.keybind-quick-cell {
    width: 136px;
    min-width: 136px;
    max-width: 136px;
    margin-left: 8px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    overflow: visible;
}

.keybind-quick {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
    cursor: var(--cursor-hover);
}

.keybind-quick__box {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(202, 159, 108);
}

.keybind-quick:hover .keybind-quick__box {
    border-color: rgb(253, 199, 135);
}

.keybind-quick--on .keybind-quick__box {
    background-color: rgb(253, 199, 135);
    border-color: rgb(253, 199, 135);
}

.keybind-quick__label {
    margin-left: 6px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 13px;
    color: rgb(255, 244, 231);
    white-space: nowrap;
}

.keybind-conflict-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 4, 10, 0.78);
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.keybind-conflict-dialog {
    width: 420px;
    max-width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgba(2, 19, 52, 0.97);
}

.keybind-conflict__text {
    font-size: 16px;
    color: rgb(255, 244, 231);
    white-space: normal;
    margin-bottom: 16px;
}

.keybind-conflict__actions {
    flex-direction: row;
    justify-content: flex-end;
}

.keybind-conflict__button {
    height: 32px;
    min-height: 32px;
    margin-left: 8px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 14px;
    color: rgb(254, 221, 183);
    background-color: rgba(0, 4, 10, 0.7);
    border-width: 2px;
    border-color: rgb(202, 159, 108);
}

.keybind-conflict__button:hover {
    border-color: rgb(253, 199, 135);
    color: rgb(255, 244, 231);
}

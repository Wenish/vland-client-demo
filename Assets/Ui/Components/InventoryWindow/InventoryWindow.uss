.inventory {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    cursor: var(--cursor-ui);
}

.inventory-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    cursor: var(--cursor-ui);
}

.inventory-panel {
    width: 720px;
    height: 620px;
    cursor: var(--cursor-ui);
}

.inventory-search {
    flex-shrink: 0;
    margin-bottom: 10px;
    min-height: 40px;
    color: rgb(255, 244, 231);
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    cursor: var(--cursor-hover);
}

.inventory-search > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.inventory-search > #unity-text-input,
.inventory-search > .unity-base-text-field__input,
.inventory-search > .unity-base-field__input {
    flex-grow: 1;
    min-height: 36px;
    background-color: rgba(0, 4, 10, 0.7);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(202, 159, 108);
    border-right-color: rgb(202, 159, 108);
    border-top-color: rgb(202, 159, 108);
    border-bottom-color: rgb(202, 159, 108);
    color: rgb(255, 244, 231);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    --unity-cursor-color: rgb(255, 244, 231);
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 15px;
    cursor: var(--cursor-hover);
}

.inventory-search > #unity-text-input:hover,
.inventory-search > .unity-base-text-field__input:hover,
.inventory-search > .unity-base-field__input:hover {
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
}

.inventory-search:focus > #unity-text-input,
.inventory-search:focus > .unity-base-text-field__input,
.inventory-search:focus > .unity-base-field__input {
    border-left-color: rgb(255, 244, 231);
    border-right-color: rgb(255, 244, 231);
    border-top-color: rgb(255, 244, 231);
    border-bottom-color: rgb(255, 244, 231);
}

.inventory-search .unity-base-text-field__input--placeholder,
.inventory-search #unity-text-input--placeholder {
    color: rgb(154, 161, 174);
}

.inventory-filters {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.inventory-filter {
    min-height: 28px;
    max-height: 28px;
    height: 28px;
    margin-top: 0;
    margin-bottom: 6px;
    margin-right: 6px;
    margin-left: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 13px;
    color: rgb(204, 208, 214);
    background-image: none;
    background-color: rgba(255, 244, 231, 0.06);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(202, 159, 108, 0.35);
    border-right-color: rgba(202, 159, 108, 0.35);
    border-top-color: rgba(202, 159, 108, 0.35);
    border-bottom-color: rgba(202, 159, 108, 0.35);
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    cursor: var(--cursor-hover);
}

.inventory-filter:hover {
    color: rgb(255, 244, 231);
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
}

.inventory-filter--active {
    color: rgb(254, 221, 183);
    background-color: rgba(253, 199, 135, 0.16);
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
}

.inventory-body {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
    margin-top: 4px;
}

.inventory-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 12px;
}

.inventory-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.inventory-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.inventory-scroll > .unity-scroll-view__content-viewport {
    margin-right: 4px;
}

.inventory-scroll .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    margin-left: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: transparent;
    border-width: 0;
}

.inventory-scroll .unity-base-slider--vertical {
    width: 10px;
    min-width: 10px;
}

.inventory-scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
}

.inventory-scroll .unity-scroller--vertical,
.inventory-scroll .unity-base-slider--vertical,
.inventory-scroll .unity-base-slider__tracker,
.inventory-scroll .unity-base-slider__drag-container {
    cursor: var(--cursor-ui);
}

.inventory-scroll .unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgb(1, 11, 31);
    width: 6px;
    min-width: 6px;
    left: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(101, 80, 54);
    border-right-color: rgb(101, 80, 54);
    border-top-color: rgb(101, 80, 54);
    border-bottom-color: rgb(101, 80, 54);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.inventory-scroll .unity-base-slider__dragger {
    background-color: rgb(202, 159, 108);
    width: 6px;
    min-width: 6px;
    left: 2px;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    cursor: var(--cursor-hover);
}

.inventory-scroll .unity-base-slider__dragger-border {
    border-width: 0;
    background-color: transparent;
}

.inventory-scroll .unity-scroller--vertical:hover .unity-base-slider__dragger,
.inventory-scroll .unity-base-slider__dragger:hover {
    background-color: rgb(253, 199, 135);
}

.inventory-list {
    flex-direction: column;
    width: 100%;
}

.inventory-row {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    margin-bottom: 6px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: rgba(255, 244, 231, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(202, 159, 108, 0.25);
    border-right-color: rgba(202, 159, 108, 0.25);
    border-top-color: rgba(202, 159, 108, 0.25);
    border-bottom-color: rgba(202, 159, 108, 0.25);
    cursor: var(--cursor-hover);
}

.inventory-row:hover {
    background-color: rgba(255, 244, 231, 0.08);
}

.inventory-row--selected {
    background-color: rgba(253, 199, 135, 0.14);
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
}

.inventory-row--last {
    margin-bottom: 0;
}

.inventory-row__icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: rgba(0, 0, 0, 0.35);
    background-size: cover;
    background-position: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    cursor: var(--cursor-hover);
}

.inventory-row__stack {
    position: absolute;
    right: 2px;
    bottom: 2px;
    font-size: 11px;
    color: rgb(255, 244, 231);
    background-color: rgba(0, 0, 0, 0.65);
    padding-left: 4px;
    padding-right: 4px;
}

.inventory-icon--common {
    border-left-color: rgb(170, 170, 170);
    border-right-color: rgb(170, 170, 170);
    border-top-color: rgb(170, 170, 170);
    border-bottom-color: rgb(170, 170, 170);
}

.inventory-icon--uncommon {
    border-left-color: rgb(64, 200, 90);
    border-right-color: rgb(64, 200, 90);
    border-top-color: rgb(64, 200, 90);
    border-bottom-color: rgb(64, 200, 90);
}

.inventory-icon--rare {
    border-left-color: rgb(64, 140, 255);
    border-right-color: rgb(64, 140, 255);
    border-top-color: rgb(64, 140, 255);
    border-bottom-color: rgb(64, 140, 255);
}

.inventory-icon--epic {
    border-left-color: rgb(176, 80, 255);
    border-right-color: rgb(176, 80, 255);
    border-top-color: rgb(176, 80, 255);
    border-bottom-color: rgb(176, 80, 255);
}

.inventory-icon--legendary {
    border-left-color: rgb(255, 180, 60);
    border-right-color: rgb(255, 180, 60);
    border-top-color: rgb(255, 180, 60);
    border-bottom-color: rgb(255, 180, 60);
}

.inventory-row__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    cursor: var(--cursor-hover);
}

.inventory-row__name {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Bold.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e81&type=3#MerriweatherSans-Bold");
    font-size: 16px;
    color: rgb(255, 244, 231);
    margin: 0;
    padding: 0;
    white-space: normal;
    cursor: var(--cursor-hover);
}

.inventory-row__meta {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 12px;
    color: rgb(254, 221, 183);
    margin-top: 4px;
    margin-bottom: 0;
    padding: 0;
    cursor: var(--cursor-hover);
}

.inventory-row__summary {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 13px;
    color: rgb(204, 208, 214);
    margin-top: 4px;
    margin-bottom: 0;
    padding: 0;
    white-space: normal;
    cursor: var(--cursor-hover);
}

.inventory-empty {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 14px;
    color: rgba(204, 208, 214, 0.75);
    white-space: normal;
    padding-top: 12px;
    padding-right: 8px;
    padding-bottom: 12px;
    padding-left: 8px;
}

.inventory-detail {
    width: 280px;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 8px;
}

.inventory-detail__icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    background-size: cover;
    background-position: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.inventory-detail__name {
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    font-size: 22px;
    color: rgb(254, 221, 183);
    white-space: normal;
    margin-bottom: 6px;
}

.inventory-detail__meta {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 13px;
    color: rgb(204, 208, 214);
    white-space: normal;
    margin-bottom: 8px;
}

.inventory-detail__description {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 13px;
    color: rgb(204, 208, 214);
    white-space: normal;
    margin-bottom: 10px;
}

.inventory-detail__stats {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 14px;
    color: rgb(204, 208, 214);
    white-space: normal;
    flex-grow: 1;
}

.inventory-row--disabled {
    opacity: 0.45;
}

.inventory-row--disabled:hover {
    background-color: rgba(255, 244, 231, 0.04);
}

.inventory-detail__notice {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 13px;
    color: rgb(255, 170, 120);
    white-space: normal;
    margin-bottom: 8px;
}

.inventory-detail__empty {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 14px;
    color: rgba(204, 208, 214, 0.75);
    white-space: normal;
}

.inventory-equip-button {
    margin-top: 12px;
    flex-shrink: 0;
}

.inventory-destroy-button {
    margin-top: 12px;
    flex-shrink: 0;
}

.inventory-confirm {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    background-color: rgba(0, 4, 10, 0.92);
    border-top-width: 1px;
    border-top-color: rgb(152, 119, 81);
    flex-direction: column;
}

.inventory-confirm__message {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 15px;
    color: rgb(255, 244, 231);
    margin-bottom: 10px;
}

.inventory-confirm__row {
    flex-direction: row;
    justify-content: flex-end;
}

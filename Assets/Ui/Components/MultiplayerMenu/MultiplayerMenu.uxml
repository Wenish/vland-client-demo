<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/GameBase.uss?fileID=7433441132597879392&amp;guid=b63ce31c77e10af4eab5a904fdde83f4&amp;type=3#GameBase"/>
    <Style src="project://database/Assets/Ui/Components/MultiplayerMenu/MultiplayerMenu.uss?fileID=7433441132597879392&amp;guid=01e26c624bb3744028990e2b93c31395&amp;type=3#MultiplayerMenu"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; align-self: center;">
        <ui:VisualElement name="panel" class="si-panel multiplayer-menu__panel">
            <ui:Label text="MULTIPLAYER" class="si-panel__title"/>
            <OrnateButton text="HOST GAME" name="buttonHostGame" icon-image="project://database/Assets/Art/Ui/Icons/icon-host.svg?fileID=2800000&amp;guid=e1a1b2c3d4e5f60718293a4b5c6d7ea6&amp;type=3#icon-host"/>
            <OrnateButton text="JOIN GAME" name="buttonJoinGame" icon-image="project://database/Assets/Art/Ui/Icons/icon-join.svg?fileID=2800000&amp;guid=e1a1b2c3d4e5f60718293a4b5c6d7ea7&amp;type=3#icon-join"/>
            <OrnateButton text="SERVER BROWSER" name="buttonServerBrowser" style="display: none;"/>
            <OrnateButton text="SERVER ONLY" name="buttonServerOnly" class="si-button si-button--compact" style="margin-top: 14px;"/>
            <OrnateButton text="BACK" name="buttonBackToMainMenu" class="si-button si-button--compact" icon-image="project://database/Assets/Art/Ui/Icons/icon-back.svg?fileID=2800000&amp;guid=e1a1b2c3d4e5f60718293a4b5c6d7ea8&amp;type=3#icon-back" style="margin-top: 14px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

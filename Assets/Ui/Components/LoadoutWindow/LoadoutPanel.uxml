<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:si="ShadowInfection.UI" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/GameBase.uss?fileID=7433441132597879392&amp;guid=b63ce31c77e10af4eab5a904fdde83f4&amp;type=3#GameBase" />
    <Style src="project://database/Assets/Ui/Components/LoadoutWindow/LoadoutPanel.uss?fileID=7433441132597879392&amp;guid=944f6fbfff0544f328370fe0becc3d5e&amp;type=3#LoadoutPanel" />
    <Style src="project://database/Assets/Ui/Components/LoadoutWindow/LoadoutWindow.uss?fileID=7433441132597879392&amp;guid=fd95136e139f74611ac3c86a490dd7f5&amp;type=3#LoadoutWindow" />
    <ui:VisualElement name="loadoutRoot" picking-mode="Ignore" class="loadout">
        <ui:VisualElement name="loadoutOverlay" picking-mode="Position" class="loadout-overlay" style="display: none;">
            <si:FloatingWindow name="LoadoutPanel" picking-mode="Position" class="loadout-panel" title="Loadout" draggable="false">
                <ui:VisualElement name="slotsBar" class="loadout-slots" />
                <ui:Label name="subheading" text="Choosing: Passive" class="loadout-subheading" />
                <ui:VisualElement name="filterBar" class="loadout-filters" />
                <ui:VisualElement name="body" class="loadout-body">
                    <ui:ScrollView name="itemScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="loadout-scroll">
                        <ui:VisualElement name="itemList" class="loadout-list" />
                    </ui:ScrollView>
                    <ui:VisualElement name="detailPane" class="loadout-detail">
                        <ui:VisualElement name="detailIcon" class="loadout-detail__icon" />
                        <ui:Label name="detailName" text="" class="loadout-detail__name" />
                        <ui:VisualElement name="detailTags" class="loadout-detail__tags" />
                        <ui:Label name="detailMeta" text="" class="loadout-detail__meta" />
                        <ui:Label name="detailDescription" text="" class="loadout-detail__description" />
                        <ui:Label name="detailEmpty" text="Select a slot, then pick a skill." class="loadout-detail__empty" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </si:FloatingWindow>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

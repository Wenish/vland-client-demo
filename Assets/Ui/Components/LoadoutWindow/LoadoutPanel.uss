.loadout {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    cursor: var(--cursor-ui);
}

.loadout-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 4, 10, 0.72);
    cursor: var(--cursor-ui);
}

.loadout-panel {
    width: 70%;
    height: 75%;
    max-width: 1100px;
    max-height: 800px;
    min-width: 640px;
    min-height: 480px;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    cursor: var(--cursor-ui);
}

.loadout-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.loadout-header {
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    font-size: 32px;
    color: rgb(254, 221, 183);
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    cursor: var(--cursor-ui);
}

.loadout-close-button {
    flex-shrink: 0;
}

.loadout-subheading {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 15px;
    color: rgb(254, 221, 183);
    margin-top: 10px;
    margin-bottom: 8px;
    flex-shrink: 0;
    cursor: var(--cursor-ui);
}

.loadout-body {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
    margin-top: 4px;
}

.loadout-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 14px;
    background-color: rgba(0, 4, 10, 0.45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(202, 159, 108, 0.35);
    border-right-color: rgba(202, 159, 108, 0.35);
    border-top-color: rgba(202, 159, 108, 0.35);
    border-bottom-color: rgba(202, 159, 108, 0.35);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    cursor: var(--cursor-ui);
}

.loadout-list {
    flex-direction: column;
    width: 100%;
}

.loadout-detail {
    width: 36%;
    min-width: 260px;
    max-width: 380px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    background-color: rgba(0, 4, 10, 0.45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(202, 159, 108, 0.35);
    border-right-color: rgba(202, 159, 108, 0.35);
    border-top-color: rgba(202, 159, 108, 0.35);
    border-bottom-color: rgba(202, 159, 108, 0.35);
    cursor: var(--cursor-ui);
}

.loadout-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.loadout-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.loadout-scroll > .unity-scroll-view__content-viewport {
    margin-right: 4px;
}

.loadout-scroll .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    margin-left: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: transparent;
    border-width: 0;
}

.loadout-scroll .unity-base-slider--vertical {
    width: 10px;
    min-width: 10px;
}

.loadout-scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
}

.loadout-scroll .unity-scroller--vertical,
.loadout-scroll .unity-base-slider--vertical,
.loadout-scroll .unity-base-slider__tracker,
.loadout-scroll .unity-base-slider__drag-container {
    cursor: var(--cursor-ui);
}

.loadout-scroll .unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgb(1, 11, 31);
    width: 6px;
    min-width: 6px;
    left: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(101, 80, 54);
    border-right-color: rgb(101, 80, 54);
    border-top-color: rgb(101, 80, 54);
    border-bottom-color: rgb(101, 80, 54);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.loadout-scroll .unity-base-slider__dragger {
    background-color: rgb(202, 159, 108);
    width: 6px;
    min-width: 6px;
    left: 2px;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    cursor: var(--cursor-hover);
}

.loadout-scroll .unity-base-slider__dragger-border {
    border-width: 0;
    background-color: transparent;
}

.loadout-scroll .unity-scroller--vertical:hover .unity-base-slider__dragger,
.loadout-scroll .unity-base-slider__dragger:hover {
    background-color: rgb(253, 199, 135);
}

/* Root */
.loadout-window {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
}

/* Slots bar */
.slots-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.slot {
    width: 52px;
    height: 52px;
    padding: 3px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(152, 119, 81);
    background-color: rgba(2, 19, 52, 0.7);
}

.slot.active {
    border-color: rgb(253, 199, 135);
    background-color: rgba(253, 199, 135, 0.12);
}

.slot__icon {
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.3);
    background-size: cover;
    background-position: center;
    border-radius: 6px;
}

.slot__label { display: none; }

/* Scroll container */
.loadout-scroll {
    flex-grow: 1;
}

/* Subheading */
.loadout-subheading {
    margin-top: 8px;
    margin-bottom: 6px;
    font-size: 18px;
    color: rgb(254, 221, 183);
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
}

/* Grid */
.loadout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
}

/* Tile */
.loadout-tile {
    padding: 3px; /* small internal gap used for both row/column spacing */
    border-radius: 6px;
    border-width: 0px;
    background-color: rgba(0,0,0,0.0);
}

.loadout-tile:hover { background-color: rgba(255,255,255,0.04); }

.loadout-tile.selected { background-color: rgba(253, 199, 135, 0.12); }
.loadout-tile.selected > .loadout-tile__icon { border-color: rgb(253, 199, 135); }

.loadout-tile__icon {
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.25);
    background-size: cover;
    background-position: center;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2e2e2e;
}

.loadout-tile__label {
    margin-top: 4px;
    -unity-text-align: middle-center;
    font-size: 11px;
    color: rgb(204, 208, 214);
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
}


/* Hide and collapse the arrow buttons completely */
.loadout-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.loadout-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.loadout-scroll .unity-base-slider--vertical {
    width: 12px;
    min-width: 12px;
}

.loadout-scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
}

.loadout-scroll .unity-scroller--vertical {
    width: 12px;
}

.loadout-scroll .unity-base-slider__dragger {
    background-color: rgba(160, 160, 160, 1);
    width: 10px;
    min-width: 10px;
    left: 1px;
    border-radius: 4px;
}

.loadout-scroll .unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgba(15, 15, 15, 0.8);
    width: 10px;
    min-width: 10px;
    left: 1px;
    border-radius: 4px;
    border-width: 0px;
}
.in-game-menu__panel {
    min-width: 320px;
    align-items: stretch;
}

.in-game-settings-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 4, 10, 0.82);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.in-game-settings-window {
    width: 560px;
    max-width: 92%;
    max-height: 86%;
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    background-color: rgba(2, 19, 52, 0.96);
}

.in-game-settings-window__title-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    min-height: 36px;
}

.in-game-settings-window__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    font-size: 24px;
    color: rgb(254, 221, 183);
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
}

.in-game-settings-window__close {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 8px;
    min-width: 40px;
    min-height: 32px;
    width: 40px;
    height: 32px;
    font-size: 16px;
    letter-spacing: 0;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 0;
}

.in-game-settings-window .unity-template-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    align-items: stretch;
}

.in-game-settings-window .settings-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    max-height: 420px;
}

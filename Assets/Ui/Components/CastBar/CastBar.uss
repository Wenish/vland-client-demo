@import url("../../Theme/DesignTokens.uss");

.cast-bar {
    width: 240px;
    height: 24px;
    flex-direction: row;
    align-items: stretch;
    cursor: var(--cursor-ui);
    background-color: rgba(2, 19, 52, 0.85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(202, 159, 108);
    border-right-color: rgb(202, 159, 108);
    border-top-color: rgb(202, 159, 108);
    border-bottom-color: rgb(202, 159, 108);
    margin-bottom: 10px;
}

.cast-bar__fill {
    height: 100%;
    background-color: rgb(39, 90, 145);
}

.cast-bar__label {
    font-size: 14px;
    opacity: 0.9;
    color: rgb(255, 244, 231);
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    text-overflow: ellipsis;
    text-shadow: 0 0 1px rgb(0, 0, 0);
    flex-grow: 1;
    flex-shrink: 2;
}

.cast-bar__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cast-bar__track {
    flex-grow: 1;
    height: 22px;
}

.cast-bar__feedback {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 166, 62);
}

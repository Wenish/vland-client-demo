.character {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    cursor: var(--cursor-ui);
}

.character-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    cursor: var(--cursor-ui);
}

.character-panel {
    width: 360px;
    height: 620px;
    cursor: var(--cursor-ui);
}

.character-subheading {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 14px;
    color: rgb(254, 221, 183);
    flex-shrink: 0;
    margin-top: 10px;
    min-height: 18px;
    height: 18px;
    -unity-text-align: middle-center;
}

.character-paper-doll {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.character-equipment {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
}

.character-slot-column {
    width: 64px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: flex-start;
}

.character-slot-column .character-slot {
    margin-bottom: 16px;
}

.character-slot {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(202, 159, 108, 0.45);
    border-right-color: rgba(202, 159, 108, 0.45);
    border-top-color: rgba(202, 159, 108, 0.45);
    border-bottom-color: rgba(202, 159, 108, 0.45);
    cursor: var(--cursor-hover);
}

.character-slot--active {
    border-left-color: rgb(253, 199, 135);
    border-right-color: rgb(253, 199, 135);
    border-top-color: rgb(253, 199, 135);
    border-bottom-color: rgb(253, 199, 135);
    background-color: rgba(253, 199, 135, 0.12);
}

.character-slot__icon {
    width: 52px;
    height: 52px;
    background-size: cover;
    background-position: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.character-slot__label {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 10px;
    color: rgba(204, 208, 214, 0.8);
    -unity-text-align: middle-center;
}

.character-model-placeholder {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-width: 0;
    min-height: 0;
    margin-left: 12px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 244, 231, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(202, 159, 108, 0.25);
    border-right-color: rgba(202, 159, 108, 0.25);
    border-top-color: rgba(202, 159, 108, 0.25);
    border-bottom-color: rgba(202, 159, 108, 0.25);
}

.character-model-placeholder__label {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    font-size: 12px;
    color: rgba(204, 208, 214, 0.65);
    white-space: normal;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
}

.character-weapons {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.character-weapons .character-slot {
    margin-left: 8px;
    margin-right: 8px;
}

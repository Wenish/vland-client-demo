<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:si="ShadowInfection.UI" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/GameBase.uss?fileID=7433441132597879392&amp;guid=b63ce31c77e10af4eab5a904fdde83f4&amp;type=3#GameBase" />
    <Style src="project://database/Assets/Ui/Components/CharacterWindow/CharacterWindow.uss?fileID=7433441132597879392&amp;guid=7a1b2c3d4e5f708192a3b4c5d6e7f902&amp;type=3#CharacterWindow" />
    <ui:VisualElement name="characterRoot" picking-mode="Ignore" class="character">
        <ui:VisualElement name="characterHost" picking-mode="Ignore" class="character-host" style="display: none;">
            <si:FloatingWindow name="CharacterPanel" picking-mode="Position" class="character-panel" title="Character" draggable="true" width="360" height="620" default-placement="CenterLeft">
                <ui:VisualElement name="paperDoll" class="character-paper-doll">
                    <ui:VisualElement name="equipmentRow" class="character-equipment">
                        <ui:VisualElement name="leftColumn" class="character-slot-column">
                            <ui:VisualElement name="slotHead" class="character-slot" />
                            <ui:VisualElement name="slotShoulder" class="character-slot" />
                            <ui:VisualElement name="slotCape" class="character-slot" />
                            <ui:VisualElement name="slotChest" class="character-slot" />
                        </ui:VisualElement>
                        <ui:VisualElement name="modelPlaceholder" class="character-model-placeholder">
                            <ui:Label text="Character preview" class="character-model-placeholder__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="rightColumn" class="character-slot-column">
                            <ui:VisualElement name="slotGloves" class="character-slot" />
                            <ui:VisualElement name="slotPants" class="character-slot" />
                            <ui:VisualElement name="slotFeet" class="character-slot" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="weaponsRow" class="character-weapons">
                        <ui:VisualElement name="slotMainHand" class="character-slot" />
                        <ui:VisualElement name="slotOffHand" class="character-slot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="subheading" text="" class="character-subheading" />
            </si:FloatingWindow>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

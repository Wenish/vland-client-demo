:root {
    --ink: rgb(2, 19, 52);
    --ink-20: rgb(2, 15, 42);
    --ink-40: rgb(1, 11, 31);
    --ink-60: rgb(1, 8, 21);
    --ink-80: rgb(0, 4, 10);
    --ink-tint-20: rgb(53, 66, 93);
    --regent: rgb(39, 90, 145);
    --artiste: rgb(151, 112, 134);
    --torch: rgb(253, 199, 135);
    --torch-20: rgb(202, 159, 108);
    --torch-40: rgb(152, 119, 81);
    --torch-60: rgb(101, 80, 54);
    --torch-tint-20: rgb(253, 210, 159);
    --torch-tint-40: rgb(254, 221, 183);
    --torch-tint-80: rgb(255, 244, 231);
    --sky: rgb(116, 212, 255);
    --gardens: rgb(0, 166, 62);
    --panel: rgba(2, 19, 52, 0.86);
    --panel-border: rgb(202, 159, 108);
    --font-title: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    --font-button: url("project://database/Assets/Fonts/Cinzel/Cinzel-Bold.ttf?fileID=12800000&guid=a2b3c4d5e6f7081920a1b2c3d4e5f602&type=3#Cinzel-Bold");
    --font-body: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    --font-body-bold: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Bold.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e81&type=3#MerriweatherSans-Bold");
    --cursor-pointer: url("project://database/Assets/Art/Cursors/CursorPointer_32.png?fileID=2800000&guid=e6d3e27aaa79942b98e995d56accf2b0&type=3#CursorPointer_32") 16 16;
    --cursor-ui: url("project://database/Assets/Art/Cursors/CursorDefaultAlternativ_32.png?fileID=2800000&guid=7dd2a1cc508c64aa891e32dd530a2437&type=3#CursorDefaultAlternativ_32") 0 0;
    --cursor-hover: url("project://database/Assets/Art/Cursors/CursorHover_32.png?fileID=2800000&guid=5f8252ad3e9b547c1be980e2638f433c&type=3#CursorHover_32") 0 0;
    --cursor-trade: url("project://database/Assets/Art/Cursors/CursorTrade_32.png?fileID=2800000&guid=f3e99fc2895d66141a9c1cf99b80dc87&type=3#CursorTrade_32") 0 0;
    --icon-play: url("project://database/Assets/Art/Ui/Icons/icon-play.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea2&type=3#icon-play");
    --icon-settings: url("project://database/Assets/Art/Ui/Icons/icon-settings.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea3&type=3#icon-settings");
    --icon-credits: url("project://database/Assets/Art/Ui/Icons/icon-credits.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea4&type=3#icon-credits");
    --icon-quit: url("project://database/Assets/Art/Ui/Icons/icon-quit.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea5&type=3#icon-quit");
    --icon-host: url("project://database/Assets/Art/Ui/Icons/icon-host.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea6&type=3#icon-host");
    --icon-join: url("project://database/Assets/Art/Ui/Icons/icon-join.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea7&type=3#icon-join");
    --icon-back: url("project://database/Assets/Art/Ui/Icons/icon-back.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea8&type=3#icon-back");
    --icon-shield: url("project://database/Assets/Art/Ui/Icons/icon-shield.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ea9&type=3#icon-shield");
    --icon-health: url("project://database/Assets/Art/Ui/Icons/icon-health.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eaa&type=3#icon-health");
    --icon-coins: url("project://database/Assets/Art/Ui/Icons/icon-coins.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eab&type=3#icon-coins");
    --icon-skull: url("project://database/Assets/Art/Ui/Icons/icon-skull.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eac&type=3#icon-skull");
    --icon-sword: url("project://database/Assets/Art/Ui/Icons/icon-sword.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7ead&type=3#icon-sword");
    --icon-clock: url("project://database/Assets/Art/Ui/Icons/icon-clock.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eae&type=3#icon-clock");
    --icon-mouse-left: url("project://database/Assets/Art/Ui/Icons/icon-mouse-left.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eaf&type=3#icon-mouse-left");
    --icon-chart-up: url("project://database/Assets/Art/Ui/Icons/icon-chart-up.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eb2&type=3#icon-chart-up");
    --icon-trophy: url("project://database/Assets/Art/Ui/Icons/icon-trophy.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eb3&type=3#icon-trophy");
    --hud-fade-right: url("project://database/Assets/Art/Ui/hud-fade-right.svg?fileID=2800000&guid=e1a1b2c3d4e5f60718293a4b5c6d7eb4&type=3#hud-fade-right");
}

.si-cursor-pointer {
    cursor: var(--cursor-pointer);
}

.si-cursor-ui {
    cursor: var(--cursor-ui);
}

.si-cursor-hover {
    cursor: var(--cursor-hover);
}

.si-cursor-trade {
    cursor: var(--cursor-trade);
}

.si-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel_Decorative/CinzelDecorative-Bold.ttf?fileID=12800000&guid=d04ff877a79f3a3428c55a0b7e81074d&type=3#CinzelDecorative-Bold");
    color: rgb(255, 244, 231);
    letter-spacing: 2px;
}

.si-body {
    -unity-font-definition: url("project://database/Assets/Fonts/Merriweather_Sans/MerriweatherSans-Regular.ttf?fileID=12800000&guid=c1a1b2c3d4e5f60718293a4b5c6d7e80&type=3#MerriweatherSans-Regular");
    color: rgb(204, 208, 214);
}

.si-icon {
    -unity-background-image-tint-color: rgb(253, 199, 135);
    -unity-background-scale-mode: scale-to-fit;
}

.si-hud-icon--trophy {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    background-image: var(--icon-trophy);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(214, 165, 108);
}
